# The API key lives ONLY in the repo-root .env (RAG_Learning/.env), shared with corrective-rag:
#   NVIDIA_API_KEY=<your key>
# Optional copilot overrides (put them in the same root .env or the process environment):
# EXP_CORPUS_DIR=data/corpus          # use examples/corpus for the fictional demo
# EXP_PERSIST_DIR=chroma_store
# EXP_PERSONA_PATH=profile/persona.md
# EXP_STYLE_PATH=profile/style_examples.md
# EXP_ANSWER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# EXP_GRADER_MODEL=nvidia/nemotron-3.5-bolt-e4b
# EXP_COVERAGE_THRESHOLD=1            # graded mode: relevant chunks needed
# EXP_LEXICAL_MIN_HITS=2              # fast mode: distinct question terms a chunk must share
# EXP_DENSE_THRESHOLD=0.2             # fast mode: cosine floor a match must also reach (calibrated on the example corpus)
# EXP_ATTRIBUTION_IGNORE=Target,Apple # employer names that are common words: exempt from the guard
