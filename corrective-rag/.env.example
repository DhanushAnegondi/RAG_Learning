# Optional overrides for corrective-rag. Every value below is the default; set only what you change.
# The API key does NOT go here: put NVIDIA_API_KEY in the repo-root .env (RAG_Learning/.env).
# A project-level .env (copy of this file) is read after the root one and wins on conflicts.

# --- Models (NVIDIA NIM) ---
CRAG_LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
CRAG_GRADER_MODEL=nvidia/nemotron-3.5-bolt-e4b
CRAG_FALLBACK_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3.5-bolt-e4b
CRAG_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b

# --- Retrieval ---
CRAG_RETRIEVAL_MODE=hybrid        # hybrid | dense | bm25
CRAG_TOP_K=4                      # chunks passed to grading
CRAG_FETCH_K=12                   # candidates per retriever before RRF fusion
CRAG_RRF_K=60

# --- CRAG routing (relevant chunks after grading) ---
CRAG_CORRECT_THRESHOLD=2          # >= this: answer from local docs
CRAG_AMBIGUOUS_THRESHOLD=1        # >= this: local + web; below: web only or abstain

# --- Reliability ---
CRAG_LLM_MAX_TOKENS=4096        # output cap per call, reasoning tokens included
CRAG_LLM_TIMEOUT_S=30
CRAG_LLM_TOTAL_BUDGET_S=90
CRAG_MAX_RETRIES=3
CRAG_BACKOFF_BASE_S=0.5

# --- Web fallback (DuckDuckGo, no key) ---
CRAG_WEB_ENABLED=true
CRAG_WEB_MAX_RESULTS=4
CRAG_WEB_TIMEOUT_S=10

# --- Paths (defaults are inside this project) ---
# CRAG_PERSIST_DIR=chroma_store
# CRAG_CORPUS_DIR=data/corpus
# CRAG_TRACE_DIR=traces
